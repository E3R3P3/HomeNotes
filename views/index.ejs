<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="assets/icon.png">
    <title>HomeNotes - Tareas del Hogar</title>
    <link rel="stylesheet" href="styles/index.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📝</h1>
            <h1>Notas</h1>
            <!-- <p>Mis tareas del hogar</p> -->
        </div>

        <!-- <div class="form-section">
            <p style="color:#666;font-size:14px;">Pulsa el botón <strong>＋</strong> (esquina inferior derecha) para crear una nueva tarea.</p>
        </div> -->
        <div>
            
        </div>
        <div class="tasks-section">
            <div class="tasks-list" id="tareasList">
                <div class="empty-state">
                    <div class="empty-state-icon">✨</div>
                    <p>No hay tareas. ¡Crea una nueva!</p>
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat-item">
                <div class="stat-value" id="totalTareas">0</div>
                <div class="stat-label">Total</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="tareasCompletadas">0</div>
                <div class="stat-label">Completadas</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="tareasPendientes">0</div>
                <div class="stat-label">Pendientes</div>
            </div>
        </div>
    </div>

        <!-- Modal for create/edit -->
    <div id="modal" class="modal" style="display:none;">
        <div class="modal-backdrop" onclick="closeModal()"></div>
        <div class="modal-content">
            <h3 id="modalTitle">Nueva tarea</h3>
            <input type="text" id="modalTitulo" placeholder="Título" />
            <textarea id="modalDescripcion" placeholder="Descripción (opcional)"></textarea>

            <div style="margin-top:18px;">
                <strong>Subtareas</strong>
                <div id="subtareasList" style="margin-top:8px;display:flex;flex-direction:column;gap:8px;">
                    <!-- subtareas se renderizan aquí -->
                </div>
                <div style="display:flex;gap:8px;margin-top:8px;">
                    <input id="subtareaInput" type="text" placeholder="Añadir subtarea" style="flex:1;padding:8px;border-radius:6px;border:1px solid #ddd;" />
                    <button onclick="addSubtarea()" style="padding:8px 12px;border-radius:6px; background:#ffffff00;"><img src="https://img.icons8.com/?size=100&id=32658&format=png&color=000000" height="36px"></button>
                </div>
            </div>

            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px;">
                <button onclick="closeModal()" style="background:#f44336;color:#ffffff;padding:8px 12px;border-radius:6px;">Cancelar</button>
                <button onclick="saveModal()">Guardar</button>
            </div>
        </div>
    </div>

        <!-- Delete confirmation modal for tasks -->
        <div id="deleteModal" class="modal" style="display:none;">
            <div class="modal-backdrop" onclick="closeDeleteModal()"></div>
            <div class="modal-content">
                <h3>Eliminar tarea</h3>
                <p id="deleteMsg">¿Estás seguro que deseas eliminar esta tarea?</p>
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:10px;">
                    <button onclick="closeDeleteModal()" style="background:#ddd;color:#333;padding:8px 12px;border-radius:6px;">Cancelar</button>
                    <button id="confirmDeleteBtn" onclick="confirmDelete()" style="background:#ff6b6b;color:white;padding:8px 12px;border-radius:6px;">Eliminar</button>
                </div>
            </div>
        </div>

        <!-- Delete confirmation modal for subtasks -->
        <div id="deleteSubModal" class="modal" style="display:none;">
            <div class="modal-backdrop" onclick="closeDeleteSubModal()"></div>
            <div class="modal-content">
                <h3>Eliminar subtarea</h3>
                <p>¿Estás seguro que deseas eliminar esta subtarea?</p>
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:10px;">
                    <button onclick="closeDeleteSubModal()" style="background:#ddd;color:#333;padding:8px 12px;border-radius:6px;">Cancelar</button>
                    <button onclick="confirmDeleteSub()" style="background:#ff6b6b;color:white;padding:8px 12px;border-radius:6px;">Eliminar</button>
                </div>
            </div>
        </div>

        <!-- Edit subtask modal -->
        <div id="editSubModal" class="modal" style="display:none;">
            <div class="modal-backdrop" onclick="closeEditSubModal()"></div>
            <div class="modal-content">
                <h3>Editar subtarea</h3>
                <input type="text" id="editSubInput" placeholder="Título" style="width:100%;margin-top:8px;padding:10px;border-radius:8px;border:1px solid #ddd;" />
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:10px;">
                    <button onclick="closeEditSubModal()" style="background:#ddd;color:#333;padding:8px 12px;border-radius:6px;">Cancelar</button>
                    <button onclick="confirmEditSub()" style="padding:8px 12px;border-radius:6px;">Guardar</button>
                </div>
            </div>
        </div>

    <!-- Floating Action Button -->
    <button id="fab" class="fab" onclick="openModal('new')"><img src="https://img.icons8.com/?size=100&id=32658&format=png&color=000000" height="36px"></button>

    <!-- Toast -->
    <div id="toast" class="toast" style="display:none;"></div>

    <script src="src/scripts.js"></script>
</body>
</html>